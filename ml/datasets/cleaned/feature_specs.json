      "origin": "Real industrial pump sensor log (public Kaggle dataset)",
      "note": "FIELD-like time-series with documented breakdown events."
    },
    "esp": {
      "task": "classification",
      "target": "label_id",
      "features": [
        "median(8,13)",
        "rms(98,102)",
        "median(98,102)",
        "peak1x",
        "peak2x",
        "a",
        "b"
      ],
      "group_col": "esp_id",
      "label_map": {
        "Normal": 0,
        "Unbalance": 1,
        "Faulty sensor": 2,
        "Rubbing": 3,
        "Misalignment": 4
      },
      "origin": "ESP vibration-derived features (ESPset, 11 ESPs)",
      "note": "Real ESP fault classes from vibration feature extraction."
    },
    "sorush": {
      "task": "regression",
      "target": "ql_stb_d",
      "features": [
        "choke_d64",
        "pwh_psig",
        "oil_gravity",
        "glr_scf_stb"
      ],
      "origin": "Sorush oil field production records (Barjouei et al. 2021, J. Pet. Explor. Prod. Technol.) — REAL field data.",
      "benchmark": {
        "paper_RMSE_STB_D": 196,
        "paper_R2": 0.9969,
        "algorithms_compared": "DL > DT > RF > ANN > SVR"
      }
    }
