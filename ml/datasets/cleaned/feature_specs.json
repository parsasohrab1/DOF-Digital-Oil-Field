{
  "datasets": {
    "cmapss": {
      "task": "regression",
      "target": "RUL",
      "features": [
        "op_set_1",
        "op_set_2",
        "s2",
        "s3",
        "s4",
        "s6",
        "s7",
        "s8",
        "s9",
        "s11",
        "s12",
        "s13",
        "s14",
        "s15",
        "s17",
        "s20",
        "s21"
      ],
      "group_col": "unit",
      "origin": "NASA C-MAPSS turbofan simulation (public benchmark)",
      "note": "SIMULATED degradation — not field oil/gas measurements; valid for RUL methodology."
    },
    "cwru": {
      "task": "classification",
      "target": "label",
      "features": [
        "max",
        "min",
        "mean",
        "sd",
        "rms",
        "skewness",
        "kurtosis",
        "crest",
        "form"
      ],
      "label_map": {
        "Normal": 0,
        "InnerRace": 1,
        "OuterRace": 2,
        "Ball": 3
      },
      "origin": "CWRU bearing test-rig laboratory data (public benchmark)",
      "note": "LABORATORY vibration measurements — real measured accelerations."
    },
    "pump": {
      "task": "anomaly_detection+forecasting",
      "anomaly_target": "anomaly",
      "forecast_col": "sensor_00",
      "features": [
